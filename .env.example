# =============================================================================
# Mail Intelligence Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_LOG_FORMAT=console

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mip
POSTGRES_PASSWORD=mip_dev_password
POSTGRES_DB=mail_intelligence

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Elasticsearch ---
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# --- Object Storage (MinIO / S3) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=mail-intelligence
OBJECT_STORAGE_REGION=us-east-1

# --- Microsoft Graph OAuth (Milestone 1+) ---
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=consumers

# --- LLM Provider (Milestone 5+) ---
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# OPENAI_API_KEY=

# --- Embedding Provider (Milestone 4+) ---
# EMBEDDING_MODEL_ID=text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072
