# =============================================================================
# Mail Intelligence Platform â€” Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_LOG_FORMAT=console

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mip
POSTGRES_PASSWORD=mip_dev_password
POSTGRES_DB=mail_intelligence

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Elasticsearch ---
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http

# --- Object Storage (MinIO / S3) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=mail-intelligence
OBJECT_STORAGE_REGION=us-east-1

# --- Authentication Core (PR-1.2+) ---
JWT_SIGNING_SECRET=dev-only-change-me-minimum-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=mail-intelligence-platform
JWT_AUDIENCE=mail-intelligence-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_CLOCK_SKEW_SECONDS=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_IDLE_TIMEOUT_HOURS=8
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
SESSION_REMEMBER_ME_DAYS=90
# --- Microsoft Graph OAuth (Milestone 1+) ---
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=consumers

# --- LLM Provider (Milestone 5+) ---
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# OPENAI_API_KEY=

